# Postgres connection string used by Prisma (see docker-compose.yml for the local db service).
DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_claims?schema=public"

# Separate DB used only by the integration test suite (docker-compose.yml's
# db_test service, started with `docker compose --profile test up -d db_test`),
# so `npm test` never touches dev data.
TEST_DATABASE_URL="postgresql://expense:expense@localhost:5433/expense_claims_test?schema=public"

# HTTP port the API listens on.
PORT=4000

# Origin(s) the SPA is served from, for CORS. Comma-separated to allow more
# than one frontend at once (e.g. a local dev frontend + a deployed one).
# Each request's Origin is checked against this exact list — not a wildcard;
# credentialed CORS (our cookie auth) can't use `*` anyway.
CORS_ORIGIN="http://localhost:5173"
# CORS_ORIGIN="http://localhost:5173,https://your-deployed-frontend.example.com"

# Secret used to sign JWTs. Generate a real random value for anything beyond local dev,
# e.g. `openssl rand -hex 32`.
JWT_SECRET="change-me-to-a-long-random-string"

# Access token lifetime, in seconds. Also the httpOnly cookie's maxAge.
JWT_EXPIRES_IN_SECONDS=86400

# bcrypt cost factor for password hashing.
BCRYPT_SALT_ROUNDS=10

# Absolute or relative path where uploaded receipts are stored on disk.
# Never served as static files — always read through the authenticated download endpoint.
UPLOAD_DIR="./uploads"

# Optional: store receipts in Cloudinary instead of UPLOAD_DIR. Set all three
# (Cloudinary dashboard -> API Keys) or none. Required on hosts without a
# persistent disk (e.g. Render's free plan), where UPLOAD_DIR is wiped on
# every restart/redeploy. Files are uploaded as private assets — never public.
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
# CLOUDINARY_FOLDER="receipts"

# Max receipt file size in bytes (5MB).
MAX_RECEIPT_SIZE_BYTES=5242880

# Claims with a total above this amount (INR) need a second, final approval
# from Finance after the assigned approver approves.
FINANCE_APPROVAL_THRESHOLD=25000

# Set to "true" in production so the auth cookie requires HTTPS.
COOKIE_SECURE=false

# --- Approval reminders -------------------------------------------------------
# A daily in-process job emails reviewers about claims waiting on them:
# PENDING_APPROVAL → the assigned approver, PENDING_FINANCE_APPROVAL → every
# active Finance user. First reminder after REMINDER_FIRST_AFTER_DAYS in the
# reviewer's queue, then every REMINDER_REPEAT_EVERY_DAYS until they act.
# Finance can also trigger a run manually: POST /finance/reminders/run.
REMINDERS_ENABLED=true
REMINDER_CRON="0 10 * * *"
REMINDER_TIMEZONE="Asia/Kolkata"
REMINDER_FIRST_AFTER_DAYS=2
REMINDER_REPEAT_EVERY_DAYS=1

# Frontend base URL for links inside emails. Defaults to the first CORS_ORIGIN.
# APP_URL="https://your-deployed-frontend.example.com"

# Outgoing email via EmailJS (dashboard -> Email Services / Email Templates /
# Account -> API keys). Set all four or none; with none, emails are only logged
# to the console (dev/tests). The template receives: to_email, subject, title,
# summary (HTML — render it with {{{summary}}}), source_url, run_date.
# "Allow EmailJS API for non-browser applications" must be enabled under
# Account -> Security, or server-side sends are rejected.
# EMAILJS_SERVICE_ID=""
# EMAILJS_TEMPLATE_ID=""
# EMAILJS_PUBLIC_KEY=""
# EMAILJS_PRIVATE_KEY=""
