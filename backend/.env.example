# Postgres connection string used by Prisma (see docker-compose.yml for the local db service).
DATABASE_URL="postgresql://expense:expense@localhost:5432/expense_claims?schema=public"

# Separate DB used only by the integration test suite (docker-compose.yml's
# db_test service, started with `docker compose --profile test up -d db_test`),
# so `npm test` never touches dev data.
TEST_DATABASE_URL="postgresql://expense:expense@localhost:5433/expense_claims_test?schema=public"

# HTTP port the API listens on.
PORT=4000

# Origin the SPA is served from, for CORS + cookie settings.
CORS_ORIGIN="http://localhost:5173"

# Secret used to sign JWTs. Generate a real random value for anything beyond local dev,
# e.g. `openssl rand -hex 32`.
JWT_SECRET="change-me-to-a-long-random-string"

# Access token lifetime, in seconds. Also the httpOnly cookie's maxAge.
JWT_EXPIRES_IN_SECONDS=86400

# bcrypt cost factor for password hashing.
BCRYPT_SALT_ROUNDS=10

# Absolute or relative path where uploaded receipts are stored on disk.
# Never served as static files — always read through the authenticated download endpoint.
UPLOAD_DIR="./uploads"

# Max receipt file size in bytes (5MB).
MAX_RECEIPT_SIZE_BYTES=5242880

# Set to "true" in production so the auth cookie requires HTTPS.
COOKIE_SECURE=false
